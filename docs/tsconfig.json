{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "lib": ["DOM", "DOM.Iterable", "ES2023"],
        // TypeScript 6 以降は types の既定値が [] になり @types/node が自動で読み込まれないため明示する
        "types": ["node"],
        "paths": {
            "styled-system/*": ["./styled-system/*"],
            "fumadocs-mdx:collections/*": ["./.source/*"]
        }
    },
    "include": ["app", "component", "lib", ".source", "source.config.ts", "content", "styled-system"]
}
