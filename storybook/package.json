{
    "name": "@chlorophyll/storybook",
    "private": true,
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "prepare": "panda codegen",
        "dev": "storybook dev -p 6006",
        "build": "storybook build",
        "serve:storybook": "http-server storybook-static -p 6006 --silent",
        "test": "test-storybook --junit",
        "vrt:capture": "node scripts/vrt-capture.mjs",
        "vrt:run": "reg-suit run",
        "test:vrt": "pnpm vrt:capture && pnpm vrt:run",
        "test:runner": "pnpm dlx concurrently -k -s first \"pnpm serve:storybook\" \"pnpm dlx wait-on tcp:6006 && pnpm test\""
    },
    "dependencies": {
        "@morinoparty/chlorophyll-react": "workspace:*",
        "@react-three/fiber": "^9.8.2",
        "lucide-react": "^1.59.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@pandacss/dev": "^1.12.1",
        "@pandacss/preset-base": "^2.2.0",
        "@pandacss/studio": "^1.12.1",
        "@storybook/addon-a11y": "^10.6.2",
        "@storybook/addon-designs": "^11.1.4",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/addon-onboarding": "^10.6.2",
        "@storybook/addon-themes": "^10.6.2",
        "@storybook/react": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@storybook/test-runner": "^0.26.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/browser": "^5.0.5",
        "@vitest/coverage-v8": "^5.0.5",
        "apca-w3": "^0.1.9",
        "axe-core": "^4.14.0",
        "axe-playwright": "^2.2.2",
        "globals": "^17.13.0",
        "http-server": "^14.1.1",
        "playwright": "^1.64.1",
        "puppeteer": "^25.14.0",
        "reg-keygen-git-hash-plugin": "^0.14.5",
        "reg-notify-github-plugin": "^0.14.5",
        "reg-publish-s3-plugin": "^0.14.4",
        "reg-suit": "^0.14.5",
        "storybook": "^10.6.2",
        "storybook-addon-designs": "^6.3.1",
        "storybook-design-token": "^5.0.0",
        "typescript": "~5.9.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "jest-junit": {
        "outputDirectory": "reports",
        "outputName": "junit.xml"
    },
    "license": "CC0-1.0"
}
