{
    "name": "chlorophyll",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "check": "vp check --fix",
        "check:ci": "vp check",
        "build": "pnpm -r build",
        "build:storybook": "node -e \"require('node:fs').rmSync('storybook/storybook-static',{recursive:true,force:true})\" && vp run build-storybook",
        "dev": "pnpm -r dev",
        "dev:docs": "pnpm --filter @chlorophyll/docs dev",
        "dev:storybook": "pnpm --filter @chlorophyll/storybook dev",
        "test": "pnpm --filter @chlorophyll/storybook test",
        "test:vrt": "pnpm --filter @chlorophyll/storybook test:vrt",
        "prepare": "pnpm -r prepare",
        "chlorophyll-cli": "node packages/cli/bin/cli.mjs"
    },
    "devDependencies": {
        "vite-plus": "catalog:"
    },
    "license": "CC0-1.0",
    "engines": {
        "node": ">=26",
        "yarn": "please use pnpm",
        "npm": "please use pnpm"
    },
    "packageManager": "pnpm@12.16.1"
}
